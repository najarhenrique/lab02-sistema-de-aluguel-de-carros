@startuml diagrama-pacotes
allowmixing
skinparam packageStyle rect

package "aluguelcarros" {

  package "Gestão de Pedidos e Contratos" as gestao {
    package "controller" as gestao_controller {}
    package "service" as gestao_service {}
    package "model" as gestao_model {}
    package "repository" as gestao_repository {}
  }

  package "Construção Dinâmica de Páginas Web" as web {
    package "templates/static" as web_templates {}
    package "render" as web_render {}
  }

  package "Infraestrutura" as infra {
    artifact "Servidor Central" as servidor
    artifact "Clientes / Agentes" as clientes
  }

}

note right of gestao
  Sub-sistema responsável por pedidos, contratos
  e comunicação com agentes (avaliação financeira, leasing).
end note

note right of web
  Geração dinâmica de páginas, templates e assets estáticos.
end note

note right of infra
  Servidor central expõe API/HTTP; clientes e agentes acessam via Internet.
end note

web_templates ..> gestao_controller : envia formulários
gestao_controller ..> gestao_service : delega regras
gestao_service ..> gestao_repository : persiste/busca
gestao_service ..> gestao_model : valida entidades
gestao_repository ..> gestao_model : lê/grava

servidor ..> clientes : comunica-se via Internet

@enduml